# Copy to .env and fill in. Never commit the real .env.

# --- Database (Neon Postgres) ---
DATABASE_URL="postgresql://user:pass@host-pooler.region.aws.neon.tech/db?sslmode=require"   # pooled — runtime queries
DIRECT_URL="postgresql://user:pass@host.region.aws.neon.tech/db?sslmode=require"             # unpooled — migrations

# --- Vibradex diagnostics hub (optional) ---
# If unset, telemetry is silently skipped (fine for local dev).
# Point this at wherever Vibradex is reachable and shares the DB your API key lives in.
VIBRADEX_URL="https://vibradex.kilianfrederix.net"
VIBRADEX_API_KEY="vib_your_api_key_here"

# --- Email (Resend) — password-reset links ---
# Leave empty in dev: the reset link is printed in the server console instead of mailed.
# In production a missing key means no reset mail is sent (the error is logged, never the link).
RESEND_API_KEY=""
MAIL_FROM="VibraFlow <noreply@kilianfrederix.net>"

# --- Public site URL — the base of links in emails ---
# REQUIRED in production (the Host header is never trusted there). In dev it falls back to the request origin.
APP_URL="https://vibraflow.kilianfrederix.net"
